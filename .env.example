# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Required — the app refuses to start without it (it never falls back to a default database).
# The test suite uses a separate database; override it with TEST_DATABASE_URL.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/chatapp_dev"
# Must be random and at least 32 characters — the server refuses to start otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000

# Set when running behind a load balancer/reverse proxy (Railway, Render, nginx…)
# so rate limiting sees the real client IP. Use the number of proxy hops (usually 1).
# Leave unset when the app is exposed directly — trusting X-Forwarded-For without a
# proxy in front lets clients spoof their IP and bypass rate limits.
# TRUST_PROXY=1

# Comma-separated allowed origins for CORS. Leave unset when the API also serves
# the built frontend (same origin). Required if the frontend is hosted separately.
# CORS_ORIGIN="https://chat.example.com"

# Used only by prisma/seed.js to create a couple of local dev accounts
SEED_USER_1_EMAIL="alice@example.com"
SEED_USER_1_PASSWORD="changeme123"
SEED_USER_2_EMAIL="bob@example.com"
SEED_USER_2_PASSWORD="changeme123"

# Optional: password reset emails via Resend (https://resend.com).
# If RESEND_API_KEY is unset, reset emails are skipped (logged, not an error).
RESEND_API_KEY=""
ALERT_EMAIL_FROM="onboarding@resend.dev"

# Base URL of the frontend, used to build the link in password reset emails.
APP_URL="http://localhost:5173"

# Web Push (browser notifications when a message arrives and the recipient
# has no live SSE connection open). Required for push to work; the app runs
# fine without them, it just can't send push notifications. Generate a pair
# with: npx web-push generate-vapid-keys
# VAPID_SUBJECT identifies the sender per the Web Push protocol (RFC 8292) —
# use a mailto: address or an https: URL you control.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Google sign-in. Optional — GET /api/auth/google 503s until all three are
# set, and email+password (POST /auth/signup) still works either way. Create
# these in Google Cloud Console under Google Auth Platform > Clients
# (Application type: Web application). GOOGLE_REDIRECT_URI must match one of
# the client's "Authorized redirect URIs" exactly, or Google answers
# redirect_uri_mismatch. While the consent screen is in Testing mode only the
# accounts listed as test users can sign in.
# GOOGLE_CLIENT_ID="<id>.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Per-user Google Drive message archive. Optional — the app runs fine
# without it, it just never prunes old messages out of Postgres and the
# "Back up to Google Drive" section on the Account page shows it as
# unavailable. Requires GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above (the same
# OAuth client Google sign-in uses) PLUS the two settings below. Register
# DRIVE_REDIRECT_URI as its own "Authorized redirect URI" in Google Cloud
# Console alongside GOOGLE_REDIRECT_URI — they must be different URLs because
# this flow requests a different (offline, drive.file) grant than sign-in's.
# DRIVE_REDIRECT_URI="http://localhost:3000/api/drive/connect/callback"

# 32 random bytes, base64-encoded — encrypts the Google Drive refresh token
# at rest (it's a long-lived credential, so it is never stored in
# plaintext). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=""

# How often the server sweeps Drive-connected users' new messages into their
# own Drive and prunes fully-archived ones from Postgres. Standard 5-field
# cron syntax; defaults to every 15 minutes if unset.
# DRIVE_SYNC_CRON="*/15 * * * *"

# Chat file attachments (images + general files) via Cloudflare R2, an
# S3-compatible object store. Optional — the app runs fine without it,
# POST /api/chat/uploads just 503s and users can still send text messages.
# Create a bucket at https://dash.cloudflare.com -> R2, then an API token
# scoped to that bucket (Manage R2 API Tokens -> Create API Token).
# Browser uploads go directly to R2, so configure bucket CORS separately:
# allow this app's development/production origins, methods GET/HEAD/PUT, and
# the Content-Type header. Keep the bucket private; downloads use short-lived
# presigned URLs and do not need public bucket access.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
