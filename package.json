{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "1:1 direct messaging — Google sign-in, add-by-ID friends, live delivery, PWA push, per-user Google Drive archive.",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:migrate && npm run test:run",
    "test:migrate": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/chatapp_test}\" prisma migrate deploy",
    "test:run": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/chatapp_test}\" JWT_SECRET=\"test-secret\" NODE_ENV=\"test\" node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "dev:fresh": "prisma migrate reset --force && node prisma/seed.js && node --watch src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^11.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "resend": "^6.18.0",
    "web-push": "^3.6.7"
  }
}
