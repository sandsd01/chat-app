// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  /// A short, shareable code (e.g. "K7XQPM2R"), distinct from the numeric
  /// primary key on purpose: `id` is sequential and guessable (id=2 tells
  /// you id=1 exists), which is fine for internal FKs but not for something
  /// users hand out publicly to be found by. Randomly generated at creation
  /// (src/lib/publicId.js); a user may replace it with a chosen one exactly
  /// once via PATCH /api/users/me, tracked by publicIdCustomized below.
  publicId            String    @unique
  /// Set true the moment a user spends their one-time custom publicId
  /// change (PATCH /api/users/me) — false means the value above is still
  /// the randomly generated original.
  publicIdCustomized  Boolean   @default(false)
  name                String?
  /// Nullable because a Google-only account never sets one — POST
  /// /auth/login must check for null before bcrypt.compare (comparing
  /// against null throws) and tell the caller to use Google instead.
  passwordHash        String?
  /// Google's stable per-account subject identifier ("sub" claim), set once
  /// on first Google sign-in and never changed. Distinct from checking
  /// `email` alone: Google itself may let a user change the email on their
  /// Google account, but `sub` never changes, so this is the actual link.
  googleId            String?   @unique
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  /// Encrypted (AES-256-GCM, key from TOKEN_ENCRYPTION_KEY) Google OAuth
  /// refresh token for the drive.file scope, set only once the user opts
  /// into Drive backup (src/routes/drive.js) — separate from sign-in, which
  /// only ever gets an online (non-refreshable) grant. A refresh token is a
  /// long-lived credential, so it is never stored in plaintext.
  driveRefreshTokenEnc String?   @db.Text
  driveConnectedAt     DateTime?
  /// The id of the "Chat Backups" folder this app created in the user's own
  /// Drive (drive.file scope only sees files/folders the app itself
  /// created), cached so every sync doesn't have to search for it again.
  driveFolderId        String?
  createdAt           DateTime  @default(now())

  conversationsAsUserA Conversation[]     @relation("ConversationUserA")
  conversationsAsUserB Conversation[]     @relation("ConversationUserB")
  sentMessages         Message[]          @relation("MessageSender")
  friendshipsAsUserA   Friendship[]       @relation("FriendshipUserA")
  friendshipsAsUserB   Friendship[]       @relation("FriendshipUserB")
  sentFriendRequests   Friendship[]       @relation("FriendshipRequestedBy")
  pushSubscriptions    PushSubscription[]
  driveArchiveFiles    DriveArchiveFile[]

  @@map("users")
}

/// One browser/device's Web Push registration. A user can have several (one
/// per browser they enabled notifications in); `endpoint` is the browser
/// push service's per-registration URL and is globally unique on its own —
/// two different users can never legitimately share one. A subscription the
/// push service reports as gone (404/410 on send) is deleted rather than
/// retried, since that status means the browser itself revoked it.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique @db.Text
  p256dh    String
  authKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("push_subscriptions")
}

enum FriendshipStatus {
  pending
  accepted
  declined
  blocked
}

/// One relationship row per unordered pair of users (userAId = lower user
/// id, userBId = higher user id — same canonicalisation trick as
/// Conversation, and for the same reason: @@unique([userAId, userBId])
/// gives an idempotent find-or-create with no separate request-direction
/// table). `requestedById` is whichever of the two actually sent the
/// request, which is the one piece of information the canonical pair
/// alone can't tell you back.
model Friendship {
  id            Int              @id @default(autoincrement())
  userAId       Int
  userBId       Int
  status        FriendshipStatus @default(pending)
  requestedById Int
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?

  userA       User @relation("FriendshipUserA", fields: [userAId], references: [id])
  userB       User @relation("FriendshipUserB", fields: [userBId], references: [id])
  requestedBy User @relation("FriendshipRequestedBy", fields: [requestedById], references: [id])

  @@unique([userAId, userBId])
  @@map("friendships")
}

/// One 1:1 direct-message thread between two users (no groups). The pair is
/// canonically ordered by the backend (userAId = lower user id, userBId =
/// higher user id), so the unique constraint below gives an idempotent
/// find-or-create with no separate participants join table.
model Conversation {
  id              Int       @id @default(autoincrement())
  userAId         Int
  userBId         Int
  lastMessageAt   DateTime?
  userALastReadAt DateTime?
  userBLastReadAt DateTime?
  createdAt       DateTime  @default(now())

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id])
  messages Message[]
  driveArchiveFiles DriveArchiveFile[]

  @@unique([userAId, userBId])
  @@map("conversations")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// One participant's own archive of one conversation, in their own Drive —
/// there are up to two rows per conversation (one per participant), each
/// pointing at a *different* Drive file in a *different* person's Drive,
/// because drive.file only ever grants access to files the app created in
/// that specific user's account. `lastArchivedMessageId` is this
/// participant's watermark: src/lib/drive.js#pruneArchivedMessages only
/// deletes a Message once every participant's row for that conversation has
/// a watermark at or past it, so a message is never lost for someone who
/// hasn't archived yet (or never connected Drive at all).
model DriveArchiveFile {
  id                    Int      @id @default(autoincrement())
  userId                Int
  conversationId        Int
  driveFileId           String
  lastArchivedMessageId Int      @default(0)
  updatedAt             DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
  @@map("drive_archive_files")
}
