// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  /// A short, shareable code (e.g. "K7XQPM2R"), distinct from the numeric
  /// primary key on purpose: `id` is sequential and guessable (id=2 tells
  /// you id=1 exists), which is fine for internal FKs but not for something
  /// users hand out publicly to be found by. Randomly generated at creation
  /// (src/lib/publicId.js); a user may replace it with a chosen one exactly
  /// once via PATCH /api/users/me, tracked by publicIdCustomized below.
  publicId             String    @unique
  /// Set true the moment a user spends their one-time custom publicId
  /// change (PATCH /api/users/me) — false means the value above is still
  /// the randomly generated original.
  publicIdCustomized   Boolean   @default(false)
  name                 String?
  /// A short free-text line shown under the display name wherever this user
  /// appears (friends list, chat header). Deliberately capped short
  /// (STATUS_MESSAGE_MAX_LENGTH in src/routes/users.js) — it's a mood/status
  /// line, not a profile bio, and it renders inline next to a name.
  /// Null and empty are the same thing to a reader; PATCH /api/users/me
  /// normalises a blank string to null so there's only one "unset" state.
  statusMessage        String?
  /// R2 object key for this user's avatar, or null to fall back to the
  /// initials badge the UI has always drawn. Only the key is stored — the
  /// URL clients actually load is a short-lived presigned GET minted per
  /// response (src/lib/attachments.js#createDownloadUrl), never a permanent
  /// link, exactly like message attachments.
  avatarKey            String?
  /// Nullable because a Google-only account never sets one — POST
  /// /auth/login must check for null before bcrypt.compare (comparing
  /// against null throws) and tell the caller to use Google instead.
  passwordHash         String?
  /// Google's stable per-account subject identifier ("sub" claim), set once
  /// on first Google sign-in and never changed. Distinct from checking
  /// `email` alone: Google itself may let a user change the email on their
  /// Google account, but `sub` never changes, so this is the actual link.
  googleId             String?   @unique
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  /// Null until the account's email is confirmed. Set immediately at
  /// creation for a Google sign-in (Google already required
  /// payload.email_verified), left null for a password signup until
  /// POST /auth/verify-email consumes verifyTokenHash. The migration that
  /// introduced this column backfilled every pre-existing row to its
  /// createdAt — retroactively gating accounts that were already in use
  /// before verification existed would be a regression, not a security fix.
  emailVerifiedAt      DateTime?
  verifyTokenHash      String?
  verifyTokenExpiresAt DateTime?
  createdAt            DateTime  @default(now())

  conversationsAsUserA Conversation[]     @relation("ConversationUserA")
  conversationsAsUserB Conversation[]     @relation("ConversationUserB")
  sentMessages         Message[]          @relation("MessageSender")
  friendshipsAsUserA   Friendship[]       @relation("FriendshipUserA")
  friendshipsAsUserB   Friendship[]       @relation("FriendshipUserB")
  sentFriendRequests   Friendship[]       @relation("FriendshipRequestedBy")
  pushSubscriptions    PushSubscription[]
  messageReactions     MessageReaction[]

  @@map("users")
}

/// One browser/device's Web Push registration. A user can have several (one
/// per browser they enabled notifications in); `endpoint` is the browser
/// push service's per-registration URL and is globally unique on its own —
/// two different users can never legitimately share one. A subscription the
/// push service reports as gone (404/410 on send) is deleted rather than
/// retried, since that status means the browser itself revoked it.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique @db.Text
  p256dh    String
  authKey   String
  /// The subscribing browser's User-Agent, kept purely so GET
  /// /api/push/subscriptions can label the rows ("Chrome on Windows")
  /// well enough for someone to tell which device they're revoking.
  /// Nullable: a client that sent no UA header still gets a working
  /// subscription, just an unlabelled one.
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("push_subscriptions")
}

enum FriendshipStatus {
  pending
  accepted
  declined
  blocked
}

/// One relationship row per unordered pair of users (userAId = lower user
/// id, userBId = higher user id — same canonicalisation trick as
/// Conversation, and for the same reason: @@unique([userAId, userBId])
/// gives an idempotent find-or-create with no separate request-direction
/// table). `requestedById` is whichever of the two actually sent the
/// request, which is the one piece of information the canonical pair
/// alone can't tell you back.
model Friendship {
  id            Int              @id @default(autoincrement())
  userAId       Int
  userBId       Int
  status        FriendshipStatus @default(pending)
  requestedById Int
  createdAt     DateTime         @default(now())
  respondedAt   DateTime?

  userA       User @relation("FriendshipUserA", fields: [userAId], references: [id])
  userB       User @relation("FriendshipUserB", fields: [userBId], references: [id])
  requestedBy User @relation("FriendshipRequestedBy", fields: [requestedById], references: [id])

  @@unique([userAId, userBId])
  @@map("friendships")
}

/// One 1:1 direct-message thread between two users (no groups). The pair is
/// canonically ordered by the backend (userAId = lower user id, userBId =
/// higher user id), so the unique constraint below gives an idempotent
/// find-or-create with no separate participants join table.
model Conversation {
  id              Int       @id @default(autoincrement())
  userAId         Int
  userBId         Int
  lastMessageAt   DateTime?
  userALastReadAt DateTime?
  userBLastReadAt DateTime?
  /// Per-participant mute: same dual-column shape as userA/BLastReadAt
  /// above, for the same reason — a reader only ever writes their own
  /// column. Muting only suppresses the push notification a new message
  /// would otherwise trigger (src/routes/chat.js's POST .../messages); it
  /// never affects the SSE "message" event, so an open tab still updates
  /// live.
  userAMuted      Boolean   @default(false)
  userBMuted      Boolean   @default(false)
  /// Null means "not pinned" — same never-set-is-null convention as
  /// userALastReadAt above, rather than a boolean, so the pinned-first sort
  /// in GET /conversations can order same-side pins by when they were
  /// pinned (most recent pin first) for free.
  userAPinnedAt   DateTime?
  userBPinnedAt   DateTime?
  /// Disappearing-message timer in seconds, null for off. Either participant
  /// may change it (unlike mute, which is per-side), and it is read exactly
  /// once per message — at send time, to stamp Message.expiresAt. Changing it
  /// therefore never affects messages already sent, which is what lets a
  /// sender know a message's lifetime at the moment they send it.
  disappearingSeconds Int?
  createdAt       DateTime  @default(now())

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id])
  messages Message[]

  @@unique([userAId, userBId])
  @@map("conversations")
}

model Message {
  id                 Int       @id @default(autoincrement())
  conversationId     Int
  senderId           Int
  /// Nullable: a message can be attachment-only with no text. Application
  /// code (not the database) enforces that body and the attachment fields
  /// below aren't both empty — see POST /conversations/:id/messages.
  body               String?   @db.Text
  /// The four fields below are all set together or all null — there's no
  /// case where only some of them are populated. attachmentType is derived
  /// server-side from the real, R2-verified mimeType at creation time
  /// ("image" if it starts with "image/", "file" otherwise); it decides
  /// whether the client renders an inline image or a download card.
  attachmentKey      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  attachmentType     String?
  createdAt          DateTime  @default(now())
  /// Set when the sender edits `body` after sending. Attachments aren't
  /// editable, only the text — see PATCH /conversations/:id/messages/:messageId.
  editedAt           DateTime?
  /// Soft delete: set instead of removing the row so conversationId/senderId
  /// stay intact for ordering, while body and every attachment field are
  /// cleared at the same time (see DELETE .../:messageId) — a deleted
  /// message's content isn't kept around in any form, consistent with this
  /// app never logging message content elsewhere either.
  deletedAt          DateTime?
  /// The message this one is replying to, if any — same conversation is
  /// enforced in application code (POST .../messages), not by the FK alone.
  /// No onDelete behavior needed: a reply survives its original being
  /// soft-deleted (deletedAt set, body cleared) the same way every other
  /// reference to a deleted message's id already does — the quoted preview
  /// just renders the same "This message was deleted." text the bubble
  /// itself would.
  replyToId          Int?
  /// The unfurled preview for the first URL in `body`, resolved
  /// asynchronously after the message is created (see POST
  /// /conversations/:id/messages). Points at a row keyed on the URL itself,
  /// so the same link shared by twenty people is fetched once.
  linkPreviewId      Int?
  /// Absolute instant this message is deleted outright by the expiry sweep
  /// (src/lib/messageExpiry.js), frozen at creation from the conversation's
  /// disappearingSeconds. Absolute rather than a duration on purpose: there
  /// is then no later read of the conversation setting that could retroact
  /// on a message already sent.
  expiresAt          DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id])
  sender       User              @relation("MessageSender", fields: [senderId], references: [id])
  reactions    MessageReaction[]
  replyTo      Message?          @relation("MessageReplyTo", fields: [replyToId], references: [id])
  replies      Message[]         @relation("MessageReplyTo")
  linkPreview  LinkPreview?      @relation(fields: [linkPreviewId], references: [id])

  @@index([conversationId, createdAt])
  /// The expiry sweep's only query is `expiresAt <= now()` across every
  /// conversation, so it gets its own index rather than scanning the table
  /// once a minute.
  @@index([expiresAt])
  @@map("messages")
}

/// One user's single emoji reaction to one message. The unique triple is
/// what makes POST .../reactions an idempotent add (react twice with the
/// same emoji and nothing changes) while still letting the same user react
/// to the same message with several different emoji. onDelete: Cascade on
/// `message` is kept as a safety net: deleting a message is a soft delete
/// today (Message.deletedAt), so nothing hard-deletes a reacted-to row, but
/// any future path that does would otherwise hit a foreign key violation.
model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

/// A cached unfurl of one URL: title/description/site name plus the
/// thumbnail's actual bytes. The bytes live here rather than being hotlinked
/// because src/app.js pins img-src to 'self', and widening it would leak
/// every *reading* user's IP to whatever host the *sending* user chose.
///
/// Never refetched. A preview is a snapshot of what the link looked like when
/// it was shared, which is the semantics a chat log wants, and it keeps cache
/// invalidation out of the design entirely. Failures are cached too
/// (status = "failed") so a dead link costs one fetch, not one per share.
model LinkPreview {
  id            Int      @id @default(autoincrement())
  /// VarChar, not Text: a btree unique index can't cover values past roughly
  /// 2704 bytes, so an unbounded column would turn an over-long URL into a
  /// runtime insert failure instead of a validation error.
  url           String   @unique @db.VarChar(2048)
  /// "ok" | "failed"
  status        String
  title         String?
  description   String?  @db.Text
  siteName      String?
  imageData     Bytes?
  imageMimeType String?
  fetchedAt     DateTime @default(now())

  messages Message[]

  @@map("link_previews")
}
